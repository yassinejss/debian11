# =============================================================================
# Debian Web Terminal — Environment Variables
# =============================================================================
# Copy to .env.local for local dev. Set all variables in Vercel project settings.
# NEVER commit .env.local or any file with real credentials to git.

# --- Turso (libSQL) Database ---
# From: https://app.turso.tech → Your Database → Settings
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# --- Initial Administrator Account ---
# Used during db:migrate to create the first admin user.
# Change immediately after first deploy.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-password-min-16-chars

# --- Session Security ---
# Generate with: openssl rand -base64 64
SESSION_SECRET=change-this-to-a-long-random-secret-string-at-least-64-chars

# --- Supervisor Secret ---
# Used to authenticate external scheduler calls to /api/internal/supervisor
# Generate with: openssl rand -hex 32
# Set this in Vercel env vars AND in your external scheduler's Authorization header.
SUPERVISOR_SECRET=change-this-to-a-long-random-hex-string

# --- Debian Sandbox Root Password ---
# Password for root inside each Debian Sandbox.
DEBIAN_ROOT_PASSWORD=change-this-to-your-root-password

# --- Vercel Project (auto-set on Vercel, needed for local dev with sandbox) ---
# From: cat .vercel/project.json  (after: vercel link)
VERCEL_OIDC_TOKEN=
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# --- Sandbox Configuration ---
# SANDBOX_IMAGE: the VCR image pushed by the GitHub Actions workflow.
# Format: team-slug/project-slug/debian-11-terminal:latest
# Or short form: debian-11-terminal:latest (if same project)
SANDBOX_IMAGE=debian-11-terminal:latest

# =============================================================================
# EXTERNAL SCHEDULER SETUP (cron-job.org — free)
# =============================================================================
#
# 1. Register at https://cron-job.org
# 2. Create a new cronjob with:
#    URL:     https://your-app.vercel.app/api/internal/supervisor
#    Method:  POST
#    Schedule: Every 10 minutes (*/10 * * * *)
#    Headers:
#      Authorization: Bearer <your-SUPERVISOR_SECRET>
#      Content-Type: application/json
#    Body:    {}
#    Timeout: 60 seconds
#
# The scheduler calls the supervisor even when no one visits the website.
# Recovery delay: up to 10 minutes (scheduler interval).
#
# IMPORTANT: Vercel Hobby sessions expire after 45 minutes.
# The supervisor resumes sandboxes and restarts registered processes.
# Running processes do NOT survive session expiry — they must be restarted.
# =============================================================================
