# ============================================================
# DEBIAN WEB TERMINAL v2 — Environment Variables
# ============================================================
# Copy to .env.local for local dev.
# Set ALL variables in Vercel Project Settings → Environment Variables.
# NEVER commit .env.local or any file with real credentials.

# ── Turso (libSQL) Database ──────────────────────────────────
# From https://app.turso.tech → Your Database → Settings
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Initial Admin Account (used by db:migrate only) ──────────
# Change the password immediately after first deploy.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-password-16chars-min

# ── Session Security ─────────────────────────────────────────
# Generate: openssl rand -base64 64
SESSION_SECRET=change-this-to-a-long-random-secret-at-least-64-chars

# ── Supervisor Secret ────────────────────────────────────────
# Used to authenticate cron-job.org calls to /api/internal/supervisor
# Generate: openssl rand -hex 32
# Set this in Vercel AND in cron-job.org Authorization header.
SUPERVISOR_SECRET=change-this-to-a-long-random-hex-string

# ── Sandbox Image ────────────────────────────────────────────
# The VCR image published by your GitHub Actions workflow.
SANDBOX_IMAGE=debian-11-terminal:latest

# ── Vercel Project (auto-set on Vercel) ──────────────────────
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# ============================================================
# EXTERNAL SCHEDULER — cron-job.org (free)
# ============================================================
# 1. Create account at https://cron-job.org
# 2. New cronjob:
#    URL:      https://your-app.vercel.app/api/internal/supervisor
#    Method:   POST
#    Schedule: Every 10 minutes (*/10 * * * *)
#    Headers:  Authorization: Bearer <SUPERVISOR_SECRET>
#              Content-Type: application/json
#    Body:     {}
#    Timeout:  60 seconds
#
# This runs even when NO ONE is visiting the site,
# keeping sandboxes alive and processes running.
# Max recovery delay after a 45-min session expires: ~10 minutes.
# ============================================================
